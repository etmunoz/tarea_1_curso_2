# --8<-- encabezado-grupo
# Archivo: .env.example
# Objetivo: Plantilla de variables de entorno (sin secretos).
# Grupo del curso: Fabio Durán - Gustavo Reyes - Ezequiel Muñoz
# Creación: 20261110 1514
# Última modificación: 20261111 2016
# --8<-- fin-encabezado-grupo

GOOGLE_API_KEY=
MODELO=gemini-3.5-flash-lite
# Agente de viajes expuesto por `langgraph dev` (lo usa el consumidor).
# El assistant_id es un UUID que el servidor asigna al grafo: se obtiene con POST /assistants/search {"graph_id": ...}
A2A_VIAJES_URL=http://127.0.0.1:2024
A2A_VIAJES_GRAPH=agente_viajes

# ── Coordinador (supervisor que enruta a varios agentes) ───────────────────────
# Servidor local de langgraph dev y grafos locales a incluir en el catálogo:
A2A_BASE=http://127.0.0.1:2024
A2A_GRAFOS_LOCALES=agente_viajes,agente_ezequiel,agente_cocina,agente_tomas
# Agentes de compañeros (sus túneles). Lista separada por comas de `url` o `url#grafo`
# (si no se indica grafo, se asume 'agente'). Ejemplo:
# URLS_AGENTES=https://verde-luna-456.trycloudflare.com#agente_ana,https://rojo-sol-789.trycloudflare.com#agente_luis
URLS_AGENTES=

# ── RAG del agente de Tomás (Redis) ────────────────────────────────────────────
# Redis del RAG de Tomás: SIEMPRE LOCAL al equipo donde corre Tomás (dockerizado).
# No se expone por red: el RAG se alcanza consultando al AGENTE Tomás (túnel HTTP de Cloudflare).
# El profesor puede usar su Redis remoto propio cambiando esta URL.
REDIS_URL=redis://localhost:6379
# - Windows (Tomás) abre el acceso TCP (scripts/win_redis_cloudflare.ps1 <host>), que deja
#   un forwarder local; entonces en el Windows: REDIS_URL=redis://localhost:6379
# - Profesor con Redis remoto propio: redis://usuario:password@host:puerto
REDIS_URL=redis://localhost:6379
# - En el Windows (Tomás): apunta al Redis del Mac, p. ej. redis://192.168.0.X:6379
# - El profesor puede usar su Redis remoto: redis://usuario:password@host:puerto
REDIS_URL=redis://localhost:6379
REDIS_INDEX=reiki
# Puertos del host para docker-compose.yml (def. 6379 / 8001). Si están ocupados, p. ej.
# en el Windows: REDIS_PORT=6380, REDISINSIGHT_PORT=8002 y REDIS_URL=redis://localhost:6380
REDIS_PORT=6379
REDISINSIGHT_PORT=8001
MODELO_EMBEDDINGS=models/gemini-embedding-001

# ── Robustez / guardrails / auth A2A (prompt 48) ───────────────────────────────
# Allow-list explícito de grafos que el coordinador puede invocar (sus "tools"):
A2A_AGENTES_PERMITIDOS=
# Operaciones A2A permitidas (mínimo privilegio): agent_card,message_send
A2A_OPERACIONES_PERMITIDAS=
# Autenticación A2A (alcance académico; ver src/coordinador/auth.py):
#   A2A_TOKEN         token Bearer que adjunta el CLIENTE a sus peticiones A2A salientes
#   A2A_TOKENS_VALIDOS lista de tokens que el RECEPTOR aceptaría (referencia; exige auth server-side)
#   A2A_MODO_DEMO     1/true para modo demostración local sin exigir token en el receptor
A2A_TOKEN=
A2A_TOKENS_VALIDOS=
A2A_MODO_DEMO=1
# Identidades (referencia): JSON {grafo: {endpoint, capacidades:[...]}}
A2A_IDENTIDADES=
# Política ante respuesta remota sospechosa: ALLOW | SANITIZE (def.) | BLOCK
GUARDRAIL_POLITICA_A2A=SANITIZE
# Límites de guardrails (caracteres):
GUARDRAIL_MAX_ENTRADA=4000
GUARDRAIL_MAX_SALIDA=8000
# Timeouts A2A (segundos) y TTL de disponibilidad del catálogo:
A2A_TIMEOUT_CONN=10
A2A_TIMEOUT_READ=90
A2A_DISP_TTL=15
A2A_CARD_TTL=120

# ── Interoperabilidad / puente (prompt 49/48b) ─────────────────────────────────
# Hosts a los que SÍ se envía nuestro A2A_TOKEN (además del A2A_BASE y localhost).
# El token NUNCA se manda a endpoints de terceros (p. ej. el túnel de un compañero).
A2A_HOSTS_CONFIABLES=
# Token que EXIGE el puente a quien lo consuma (vacío = modo demo abierto):
PUENTE_TOKEN=
#
# Config del puente A2A clásico (src/puente_a2a/servidor.py). Expone un agente nuestro para
# que un cliente A2A estándar (p. ej. el de Gustavo) lo consuma. Variables:
#   PUENTE_BASE         langgraph dev local a exponer      (def. http://127.0.0.1:2024)
#   PUENTE_GRAFO        grafo a exponer                    (def. agente_ezequiel)
#   PUENTE_PORT         puerto del puente                  (def. 8790)
#   PUENTE_URL_PUBLICA  URL pública (túnel Cloudflare) que la card ANUNCIA como su endpoint
#   PUENTE_LOG          ruta de un archivo para el log de accesos (lo lee tools/monitor_puente.py)
#
# IMPORTANTE sobre PUENTE_URL_PUBLICA: es la URL que un cliente usará para mandarte mensajes.
# El túnel rápido de Cloudflare CAMBIA de URL en cada corrida, así que NO conviene fijarla aquí
# (quedaría obsoleta — eso fue lo que le pasó al compañero). Pásala AL LANZAR, con el valor del
# túnel vigente, usando el script:
#     ./scripts/mac_puente.sh "https://<tu-tunel-actual>.trycloudflare.com"
# (o PUENTE_URL_PUBLICA="https://…" uv run python -m src.puente_a2a.servidor). Si la dejas en el
# .env, acuérdate de actualizarla cada vez que el túnel cambie y reiniciar el puente.
PUENTE_BASE=http://127.0.0.1:2024
PUENTE_GRAFO=agente_ezequiel
PUENTE_PORT=8790
PUENTE_URL_PUBLICA=
PUENTE_LOG=
#
# Fichas automáticas (tools/configurar_fichas.py --vigilar): langgraph dev borra las Agent Cards
# al recargar; el vigilante las re-aplica solo. Intervalo de chequeo en segundos:
FICHAS_INTERVALO=5
