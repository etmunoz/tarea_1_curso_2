# Archivo: deploy/agente-coordinador.env.example
# Objetivo: Plantilla del EnvironmentFile del coordinador. Copiar a /etc/agente-coordinador.env
#           (root:root, chmod 600) y completar los valores. NUNCA versionar el archivo con valores.
# Grupo del curso: Fabio Durán - Gustavo Reyes - Ezequiel Muñoz

# --- Acceso a la web (HTTP Basic Auth) ---
COORD_WEB_USER=coordinador
COORD_WEB_PASS=            # clave de acceso a https://coordinador.etmk.cl

# --- Envío de correo (SMTP submission del propio VPS) ---
COORD_SMTP_HOST=localhost
COORD_SMTP_PORT=587
COORD_SMTP_USER=coordinador@etmk.cl
COORD_SMTP_PASS=            # clave del buzón coordinador@etmk.cl
COORD_MAIL_FROM=coordinador@etmk.cl

# Destinatario por defecto; si no se define COORD_MAIL_ALLOW, este es la allowlist.
COORD_MAIL_TO=etmunoz@gmail.com
# Allowlist explícita (coma-separada). Sumar compañeros aquí cuando corresponda:
# COORD_MAIL_ALLOW=etmunoz@gmail.com,fabio@ejemplo.cl,gustavo@ejemplo.cl
