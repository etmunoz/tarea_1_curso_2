# Archivo: deploy/systemd/agente-coordinador.service
# Objetivo: Web del coordinador A2A (:8794) publicada en https://coordinador.etmk.cl.
# Grupo del curso: Fabio Durán - Gustavo Reyes - Ezequiel Muñoz
# Secretos (Basic Auth + SMTP) van en /etc/agente-coordinador.env (ver agente-coordinador.env.example).
[Unit]
Description=Coordinador web A2A (:8794)
After=agente-langgraph.service network-online.target
Wants=agente-langgraph.service

[Service]
User=web1
Group=client1
WorkingDirectory=/var/www/clients/client1/web1/home/etmkuseragente/tarea_1_curso_2
Environment=HOME=/var/www/clients/client1/web1/home/etmkuseragente
Environment=PATH=/var/www/clients/client1/web1/home/etmkuseragente/.local/bin:/usr/local/bin:/usr/bin:/bin
Environment=COORD_WEB_HOST=127.0.0.1
Environment=COORD_WEB_PORT=8794
Environment=A2A_BASE=http://127.0.0.1:2024
Environment=COORD_URLS_FILE=/var/www/clients/client1/web1/home/etmkuseragente/tarea_1_curso_2/logs/coordinador_urls.json
EnvironmentFile=/etc/agente-coordinador.env
ExecStartPre=/bin/sh -c 'until curl -sf -o /dev/null http://127.0.0.1:2024/ok; do sleep 2; done'
ExecStart=/var/www/clients/client1/web1/home/etmkuseragente/.local/bin/uv run python tools/coordinador_web.py
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
