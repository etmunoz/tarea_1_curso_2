# Archivo: deploy/systemd/agente-langgraph.service
# Objetivo: Agente Ezequiel (langgraph dev, A2A nativo :2024) como servicio persistente.
# Grupo del curso: Fabio Durán - Gustavo Reyes - Ezequiel Muñoz
# Copiar a /etc/systemd/system/ y ajustar WorkingDirectory/HOME/PATH al usuario real del VPS.
[Unit]
Description=Agente Ezequiel - langgraph dev (A2A nativo, :2024)
After=network-online.target
Wants=network-online.target

[Service]
User=web1
Group=client1
WorkingDirectory=/var/www/clients/client1/web1/home/etmkuseragente/tarea_1_curso_2
Environment=HOME=/var/www/clients/client1/web1/home/etmkuseragente
Environment=PATH=/var/www/clients/client1/web1/home/etmkuseragente/.local/bin:/usr/local/bin:/usr/bin:/bin
ExecStart=/var/www/clients/client1/web1/home/etmkuseragente/.local/bin/uv run langgraph dev --no-browser --host 127.0.0.1 --port 2024
Restart=always
RestartSec=5
TimeoutStartSec=120

[Install]
WantedBy=multi-user.target
