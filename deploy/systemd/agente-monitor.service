# Archivo: deploy/systemd/agente-monitor.service
# Objetivo: Backoffice web de accesos al puente (:8793) publicado en https://monitor.etmk.cl.
# Grupo del curso: Fabio Durán - Gustavo Reyes - Ezequiel Muñoz
# Secretos (usuario/clave Basic Auth) van en /etc/agente-monitor.env (ver agente-monitor.env.example).
[Unit]
Description=Backoffice web del puente A2A (:8793)
After=network-online.target
Wants=network-online.target

[Service]
User=web1
Group=client1
WorkingDirectory=/var/www/clients/client1/web1/home/etmkuseragente/tarea_1_curso_2
Environment=HOME=/var/www/clients/client1/web1/home/etmkuseragente
Environment=PATH=/var/www/clients/client1/web1/home/etmkuseragente/.local/bin:/usr/local/bin:/usr/bin:/bin
Environment=MONITOR_WEB_HOST=127.0.0.1
Environment=MONITOR_WEB_PORT=8793
Environment=MONITOR_WEB_LOG=/var/www/clients/client1/web1/home/etmkuseragente/tarea_1_curso_2/logs/puente-acceso.log
Environment=MONITOR_WEB_TITULO=agente_ezequiel
EnvironmentFile=/etc/agente-monitor.env
ExecStart=/var/www/clients/client1/web1/home/etmkuseragente/.local/bin/uv run python tools/monitor_web.py
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
