# Archivo: deploy/systemd/agente-puente.service
# Objetivo: Puente A2A clásico de Ezequiel (:8790) publicado en https://agente.etmk.cl.
# Grupo del curso: Fabio Durán - Gustavo Reyes - Ezequiel Muñoz
# Copiar a /etc/systemd/system/ y ajustar rutas al usuario real del VPS.
[Unit]
Description=Agente Ezequiel - puente A2A clasico (:8790)
After=agente-langgraph.service
Wants=agente-langgraph.service

[Service]
User=web1
Group=client1
WorkingDirectory=/var/www/clients/client1/web1/home/etmkuseragente/tarea_1_curso_2
Environment=HOME=/var/www/clients/client1/web1/home/etmkuseragente
Environment=PATH=/var/www/clients/client1/web1/home/etmkuseragente/.local/bin:/usr/local/bin:/usr/bin:/bin
Environment=PUENTE_GRAFO=agente_ezequiel
Environment=PUENTE_PORT=8790
Environment=PUENTE_URL_PUBLICA=https://agente.etmk.cl
Environment=PUENTE_LOG=/var/www/clients/client1/web1/home/etmkuseragente/tarea_1_curso_2/logs/puente-acceso.log
ExecStartPre=/bin/sh -c 'until curl -sf -o /dev/null http://127.0.0.1:2024/ok; do sleep 2; done'
ExecStart=/var/www/clients/client1/web1/home/etmkuseragente/.local/bin/uv run python -m src.puente_a2a.servidor
ExecStartPost=/bin/sh -c 'sleep 3; /var/www/clients/client1/web1/home/etmkuseragente/.local/bin/uv run python tools/configurar_fichas.py --grafos agente_ezequiel,agente_cocina || true'
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
